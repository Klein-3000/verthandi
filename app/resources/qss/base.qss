/* 基础浅色主题。暗色主题后续单独成文件，由 apply_theme 切换。 */

QWidget {
    background: #f5f6f8;
    color: #1f2328;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

/* ---------- 侧边栏 ---------- */

#Sidebar {
    background: #ffffff;
    border-right: 1px solid #e5e7eb;
}

#SidebarTitle {
    font-size: 16px;
    font-weight: 600;
    padding: 4px 8px 12px 8px;
    color: #111827;
    background: transparent;
}

#NavButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 8px 10px;
    color: #4b5563;
}

#NavButton:hover {
    background: #f0f2f5;
}

#NavButton:checked {
    background: #e6f0ff;
    color: #1a56db;
    font-weight: 600;
}

/* ---------- 页面通用 ---------- */

#PageTitle {
    font-size: 20px;
    font-weight: 600;
    background: transparent;
}

#MutedText {
    color: #6b7280;
    background: transparent;
}

#AboutName {
    font-size: 18px;
    font-weight: 600;
    background: transparent;
}

/* ---------- 顶部栏 ---------- */

#Toolbar {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

#ToolbarButton {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 6px 12px;
    color: #111827;
}

#ToolbarButton:hover:enabled {
    background: #e5e7eb;
}

#ToolbarButton:disabled {
    color: #9ca3af;
}

#ModeBadge {
    background: transparent;
    padding: 4px 8px;
    color: #374151;
}

#IconButton {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 5px 10px;
}

#IconButton:hover:enabled {
    background: #dbeafe;
    color: #1e3a8a;
    border-color: #93c5fd;
}

#IconButton:disabled {
    background: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

/* ---------- 卡片 ---------- */

#Card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

#CardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    background: transparent;
}

#StatusKey {
    color: #6b7280;
    background: transparent;
}

#StatusValue {
    color: #111827;
    background: transparent;
}

/* ---------- 日志 ---------- */

#LogView {
    background: #0f172a;
    color: #cbd5e1;
    border-radius: 6px;
    padding: 10px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

/* 日志区工具条 */

QComboBox {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #cbd5e1;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

/* 日志文本 */

#LogView {
    background: #0f172a;
    color: #cbd5e1;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #2563eb;
}


/* 启动/停止按钮状态色 */

#ToolbarButton[variant="start"] {
    background: #16a34a;
    color: #ffffff;
    border: 1px solid #15803d;
}

#ToolbarButton[variant="start"]:hover {
    background: #15803d;
}

#ToolbarButton[variant="stop"] {
    background: #dc2626;
    color: #ffffff;
    border: 1px solid #b91c1c;
}

#ToolbarButton[variant="stop"]:hover {
    background: #b91c1c;
}

#ToolbarButton[variant="busy"] {
    background: #e5e7eb;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

/* ---------- 设置页 Checkbox ---------- */

QCheckBox {
    background: transparent;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #93c5fd;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border-color: #1d4ed8;
}

/* ---------- 设置页 QSpinBox ---------- */

QSpinBox {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 3px 6px;
    min-height: 22px;
}

QSpinBox:focus {
    border-color: #93c5fd;
}

QSpinBox:disabled {
    background: #f3f4f6;
    color: #9ca3af;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}

/* ---------- 端口状态徽章 ---------- */

#PortStatus {
    background: transparent;
    padding: 0 4px;
}

#PortStatus[state="ok"] {
    color: #16a34a;
}

#PortStatus[state="error"] {
    color: #dc2626;
}

#ToolbarButton[variant="danger"] {
    background: #dc2626;
    color: #ffffff;
    border: 1px solid #b91c1c;
}

#ToolbarButton[variant="danger"]:hover {
    background: #b91c1c;
}

#PrepareStatus {
    background: transparent;
    font-size: 13px;
    color: #111827;
}

/* ---------- 状态值颜色 ---------- */

#StatusValue[state="ok"] {
    color: #16a34a;
}

#StatusValue[state="muted"] {
    color: #9ca3af;
}

/* ---------- Toast ---------- */

#Toast {
    background: rgba(17, 24, 39, 0.92);
    color: #ffffff;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* ---------- 警告条 ---------- */

#WarningBanner {
    background: #fef3c7;
    border: 1px solid #f59e0b;
    border-radius: 8px;
}

#WarningIcon {
    background: transparent;
    color: #d97706;
    font-size: 16px;
}

#WarningText {
    background: transparent;
    color: #92400e;
    font-size: 13px;
}

/* ---------- 切换按钮 ---------- */

#ToolbarButton[variant="switch"] {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #1d4ed8;
}

#ToolbarButton[variant="switch"]:hover {
    background: #1d4ed8;
}

/* ---------- 端口折叠开关 ---------- */

QToolButton#PortToggle {
    background: transparent;
    border: none;
    color: #1e40af;
    padding: 4px 0;
    font-size: 13px;
    font-weight: 600;
}

QToolButton#PortToggle:hover {
    color: #1d4ed8;
    text-decoration: underline;
}

QToolButton#PortToggle::menu-indicator {
    image: none;
    width: 0;
}

/* ---------- QScrollArea ---------- */

QScrollArea {
    background: #f5f6f8;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* 补充 danger 按钮在禁用时的灰色表现 */
#ToolbarButton[variant="danger"]:disabled {
    background: #f3f4f6;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}
